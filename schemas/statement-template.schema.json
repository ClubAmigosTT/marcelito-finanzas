{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marcelito-finanzas.local/schemas/statement-template.v1.json",
  "title": "Marcelito statement OCR template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "issuer", "statementKind", "coordinateSpace", "headerSignature", "movementRegions", "columns", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 3 },
    "issuer": { "type": "string", "minLength": 3 },
    "statementKind": { "enum": ["bank", "card"] },
    "coordinateSpace": { "const": "normalized-bottom-left" },
    "headerSignature": { "type": "object" },
    "movementRegions": { "type": "array", "minItems": 1 },
    "columns": { "type": "array", "minItems": 5 },
    "excludedTextPatterns": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" }
  }
}
