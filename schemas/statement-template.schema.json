{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marcelito-finanzas.local/schemas/statement-template.v1.json",
  "title": "Marcelito statement OCR template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "issuer", "statementKind", "coordinateSpace", "headerSignature", "movementRegions", "columns", "validation"],
  "$defs": {
    "normalizedBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "aliases", "referenceBounds", "headerAnchorX", "role"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "referenceBounds": { "$ref": "#/$defs/normalizedBounds" },
        "headerAnchorX": { "type": "number", "minimum": 0, "maximum": 1 },
        "role": { "enum": ["date", "description", "deposit", "withdrawal", "balance", "excluded"] }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 3 },
    "issuer": { "type": "string", "minLength": 3 },
    "statementKind": { "enum": ["bank", "card"] },
    "coordinateSpace": { "const": "normalized-bottom-left" },
    "headerSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutionalAny", "tableTitleAll", "allowMissingTitleWhenColumnsVerified", "minimumAlignmentScore"],
      "properties": {
        "institutionalAny": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tableTitleAll": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "allowMissingTitleWhenColumnsVerified": { "type": "boolean" },
        "minimumAlignmentScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "movementRegions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pageRole", "referenceBounds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pageRole": { "type": "string", "minLength": 1 },
          "referenceBounds": { "$ref": "#/$defs/normalizedBounds" }
        }
      }
    },
    "columns": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/column" } },
    "excludedTextPatterns": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireDate", "requireDescription", "requireSingleMovementColumn", "requireRunningBalanceEvidence", "reconciliationTolerance"],
      "properties": {
        "requireDate": { "const": true },
        "requireDescription": { "const": true },
        "requireSingleMovementColumn": { "const": true },
        "requireRunningBalanceEvidence": { "const": true },
        "reconciliationTolerance": { "type": "number", "minimum": 0, "maximum": 0.05 }
      }
    }
  }
}
