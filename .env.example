# Web build: leave empty to keep PDF reading entirely local. This endpoint is
# only the optional post-reconciliation expense classifier.
VITE_TRANSACTION_CLASSIFIER_URL=
# Backwards-compatible alias; do not point it at a PDF reader in new builds.
VITE_STATEMENT_READER_URL=
# CLI-only verification target (do not expose its token to the web build).
STATEMENT_READER_URL=

# Secure proxy (server-only; never put these in VITE_* or the mobile app).
STATEMENT_READER_API_KEY=
STATEMENT_READER_MODEL=
STATEMENT_READER_PROVIDER_URL=https://api.openai.com/v1/responses
# Compatibility aliases accepted by the proxy:
OPENAI_API_KEY=
OPENAI_STATEMENT_MODEL=
STATEMENT_READER_TOKEN=
STATEMENT_READER_ALLOWED_ORIGIN=https://marcelito-finanzas.onrender.com
STATEMENT_READER_MAX_REQUESTS_PER_MINUTE=10
STATEMENT_READER_MAX_CONCURRENT_REQUESTS=2
STATEMENT_READER_PROVIDER_TIMEOUT_MS=120000
STATEMENT_READER_MAX_OUTPUT_TOKENS=32768
